#!/usr/bin/env bash
#
# Presses the movement keys on a real editor and says where the caret landed.
#
#   motions            every case
#   motions <pattern>  the cases whose name matches the Lua pattern
#
# Wants nvim on $PATH and a pty, which `script` (util-linux) provides. Prints
# one row per case, ok or FAIL with what was expected and what happened, and
# exits non-zero on any FAIL.
#
# The cases are the word, subword and WORD ends over ASCII, Greek, accented,
# Japanese and emoji text, and every unshifted key pressed over a selection in
# Visual and in Select, which has to land where it lands without one. They are
# in .github/checks/motions.lua.

name=motions
# shellcheck source=SCRIPTDIR/../checks/harness.sh
. "$(dirname "$0")/../checks/harness.sh"

fixture=$work/fixture.txt
: > "$fixture"

editor_env="MIVN_FIXTURE='$fixture'"
start "$fixture"
load

for i in $(matching); do
  keys=$(nv "luaeval('M.setup(_A)', $i)")
  sleep 0.1

  # NOTE: every key goes in through nvim_input over the socket, one call per
  # key with a gap, which is the queue a terminal fills, in the same order.
  # Headless feedkeys is another queue, and it can pass a broken key or fail
  # a working one. The burst case puts several keys in one call, like a paste.
  for j in $(seq 1 "$keys"); do
    nv "luaeval('M.press(_A[1], _A[2])', [$i, $j])" > /dev/null
    sleep 0.12
  done
  sleep 0.1

  report "$(nv "luaeval('M.verdict(_A)', $i)")"
done

stop
exit $status
