#!/usr/bin/env bash
#
# Rewrites the version pins in lua/mivn/plugins.lua, so that file stays the
# source of truth and nvim-pack-lock.json stays a cache of it.
#
#   repin pick N  Pin every entry to the newest thing that has been out for at
#                 least N days: the newest release for plugins that cut them,
#                 the newest commit for the ones that follow a branch. Also
#                 refreshes the comments, the way write does.
#   repin strip   Replace every commit pin with what the plugin follows: a
#                 semver range for plugins that cut releases, so
#                 `vim.pack.update()` moves them to their newest tag, or the
#                 named branch for the exceptions.
#   repin write   Pin every entry to the revision in nvim-pack-lock.json and
#                 refresh its comment with the nearest tag and commit date.
#
# The weekly workflow runs pick, then an update that checks the picks out and
# rewrites the lock:
#
#   repin pick 14
#   nvim --headless "+lua vim.pack.update(nil, { force = true })" +qa
#
# By hand, to read the changelogs first, strip and write go around an
# interactive update, which takes whatever is newest:
#
#   repin strip
#   :lua vim.pack.update()
#   repin write
#
# pick waits so that a broken release has had time to be reported before I
# take it.

set -euo pipefail
cd "$(dirname "$0")/../.."

# The working copy's clones, through NVIM_APPNAME=mivn, unless the environment
# already names one; CI has only ~/.config/nvim and says so.
export NVIM_APPNAME="${NVIM_APPNAME:-mivn}"

PLUGINS=lua/mivn/plugins.lua
LOCK=nvim-pack-lock.json
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/$NVIM_APPNAME/site/pack/core/opt"

# What a plugin follows between pins: `range`, its releases, by default, or
# `branch <name>` for a repo whose tags do not describe what I run.
# nvim-treesitter tags its old master while I run the main rewrite.
follows() {
  case "$1" in
  nvim-treesitter) echo "branch main" ;;
  *) echo "range" ;;
  esac
}

# The pin description for a plugin at a revision: the nearest version tag
# plus how far past it, and the commit date. Without a tag it is the date
# alone, and without the clone the short revision. Only version tags count,
# as in pick: a moving alias such as which-key's `stable` or nvim-tree's `v1`
# is not a version.
describe() {
  local name="$1" rev="$2" dir="$DATA/$1" tag date

  if [[ -d $dir ]]; then
    tag=$(git -C "$dir" describe --tags --match 'v[0-9]*.[0-9]*.[0-9]*' "$rev" 2>/dev/null || true)
    date=$(git -C "$dir" show -s --format=%cs "$rev" 2>/dev/null || true)
  fi

  # v0.18.0-4-g626b8a5 becomes v0.18.0+4
  tag=$(sed -E 's/-([0-9]+)-g[0-9a-f]+$/+\1/' <<<"${tag:-}")

  if [[ -n ${tag:-} && -n ${date:-} ]]; then
    echo "$tag, $date"
  elif [[ -n ${date:-} ]]; then
    echo "$date"
  else
    echo "${rev:0:7}"
  fi
}

# The revision a plugin should move to: the newest thing that has been out for
# at least `days` days, or `current` when nothing is old enough yet or when
# that would move it backwards.
#
# NOTE: the fetch runs without the global git config, which can rewrite the
# https URLs to ssh (url.<base>.insteadOf) and then hang on a passphrase
# prompt when the agent holds no key.
pick() {
  local name="$1" days="$2" current="$3" dir="$DATA/$1" follow cutoff tag when chosen

  if [[ ! -d $dir ]]; then
    echo "repin: $name is not installed, so there is nothing to pick from" >&2
    exit 1
  fi

  GIT_CONFIG_GLOBAL=/dev/null git -C "$dir" fetch --quiet --tags --force origin

  follow=$(follows "$name")
  if [[ $follow == branch* ]]; then
    chosen=$(git -C "$dir" rev-list -1 --before="$days days ago" "origin/${follow#branch }")
  else
    cutoff=$(($(date +%s) - days * 86400))

    # newest first, and plain versions only: no prereleases, no moving aliases
    while read -r tag when; do
      [[ $tag =~ ^v?[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
      ((when <= cutoff)) || continue

      chosen=$(git -C "$dir" rev-parse "$tag^{commit}")
      break
    done < <(git -C "$dir" tag --sort=-version:refname --format='%(refname:short) %(creatordate:unix)')
  fi

  # never backwards: a pin taken by hand can already be newer than the wait
  if [[ -z ${chosen:-} ]] || git -C "$dir" merge-base --is-ancestor "$chosen" "$current"; then
    echo "$current"
    return
  fi

  echo "$chosen"
}

mode="${1:?usage: repin pick <days>|strip|write}"

days=""
if [[ $mode == pick ]]; then
  days="${2:?usage: repin pick <days>}"

  [[ $days =~ ^[0-9]+$ ]] || {
    echo "repin: $days is not a number of days" >&2
    exit 1
  }
fi

# name -> rev, straight from the lock file.
declare -A revs
while read -r name rev; do
  revs["$name"]="$rev"
done < <(jq -r '.plugins | to_entries[] | "\(.key) \(.value.rev)"' "$LOCK")

out=$(mktemp)
pending_comment=""

flush() {
  [[ -n $pending_comment ]] && printf '%s\n' "$pending_comment" >>"$out"
  pending_comment=""
}

# NOTE: an entry's comment is the one line directly above it, and it ends in
# its pin in parentheses. pick and write replace the parenthesized part the
# line ends in, or add one when there is none, so a group comment put
# directly above an entry would take the pin.
while IFS= read -r line; do
  # hold a comment back until the next line says whether an entry owns it
  if [[ $line =~ ^([[:space:]]*)--[[:space:]] ]]; then
    flush
    pending_comment="$line"
    continue
  fi

  if [[ $line =~ \{[[:space:]]*src[[:space:]]*=[[:space:]]*\"([^\"]+)\" ]]; then
    src="${BASH_REMATCH[1]}"
    name=$(basename "$src")
    rev="${revs[$name]:-}"
    indent="${line%%\{*}"

    if [[ -z $rev ]]; then
      echo "repin: $name is not in $LOCK" >&2
      exit 1
    fi

    if [[ $mode == strip ]]; then
      flush
      follow=$(follows "$name")
      if [[ $follow == branch* ]]; then
        printf '%s{ src = "%s", version = "%s" },\n' "$indent" "$src" "${follow#branch }" >>"$out"
      else
        printf '%s{ src = "%s", version = vim.version.range("*") },\n' "$indent" "$src" >>"$out"
      fi
      continue
    fi

    # pick chooses a revision of its own; the lock's is only its fallback.
    if [[ $mode == pick ]]; then
      rev=$(pick "$name" "$days" "$rev")
    fi

    # Refresh the pin, and the entry comment's trailing "(...)".
    if [[ $pending_comment =~ ^([[:space:]]*--[[:space:]].*[^[:space:]])[[:space:]]*\([^\(\)]*\)[[:space:]]*$ ]]; then
      pending_comment="${BASH_REMATCH[1]} ($(describe "$name" "$rev"))"
    elif [[ -n $pending_comment ]]; then
      pending_comment="$pending_comment ($(describe "$name" "$rev"))"
    fi
    flush
    printf '%s{ src = "%s", version = "%s" },\n' "$indent" "$src" "$rev" >>"$out"
    continue
  fi

  flush
  printf '%s\n' "$line" >>"$out"
done <"$PLUGINS"
flush

mv "$out" "$PLUGINS"
