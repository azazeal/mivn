#!/usr/bin/env bash
#
# Cuts a release: a signed tag on main, and a GitHub release whose notes are
# the pull requests merged since the last one, opened in my editor first so I
# can fix them before anyone sees them.
#
#   release v0.2.0
#
# Versions are semver with a leading v: minor for a monthly batch, patch for a
# fix between batches. A tag that is not semver is invisible to anything that
# compares versions.
#
# `git tag -a` is never used here and must never be: -a on the command line
# overrides tag.forceSignAnnotated, so it writes an unsigned annotated tag and
# says nothing about it. GitHub does not catch that either, since a tag
# ruleset's "require signed commits" checks the commit the tag points at, not
# the tag object. `-s` plus the verify below is the whole guard.
#
# Releases are immutable and the "tags never move" ruleset blocks force-pushing
# any tag, so a release that went out wrong is fixed by cutting the next patch
# version, never by moving this one. The notes are the one part still editable
# afterwards, on the release page.

set -euo pipefail
cd "$(dirname "$0")/../.."

die() {
  echo "release: $1" >&2
  exit 1
}

version="${1:?usage: release vMAJOR.MINOR.PATCH}"

[[ $version =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "$version is not vMAJOR.MINOR.PATCH"

# The tag names a commit everyone else can fetch, so main has to be exactly
# what the remote carries: not a branch, not dirty, not ahead.
[[ $(git branch --show-current) == "main" ]] || die "not on main"
[[ -z $(git status --porcelain) ]] || die "the working tree is dirty"

git fetch --quiet origin main
[[ $(git rev-parse HEAD) == $(git rev-parse origin/main) ]] || die "main and origin/main disagree"

if git rev-parse -q --verify "refs/tags/$version" >/dev/null; then
  die "$version already exists locally"
fi

if git ls-remote --exit-code --tags origin "refs/tags/$version" >/dev/null 2>&1; then
  die "$version already exists on the remote"
fi

last=$(git describe --tags --abbrev=0 2>/dev/null || true)
if [[ -n $last && $(git rev-list --count "$last..HEAD") -eq 0 ]]; then
  die "nothing has landed since $last"
fi

# The notes come first, because generating them creates nothing: the API reads
# the pull requests merged since the last release and hands them back. So the
# review below happens while an abort still costs nothing, with no tag written
# and nothing pushed.
notes=$(mktemp)
trap 'rm -f "$notes"' EXIT

notes_args=(-f tag_name="$version" -f target_commitish="$(git rev-parse HEAD)")

# Which release this one follows, said outright. Left to itself the API works
# it out from the target commit and has been seen to reach past the last tag,
# listing the whole history again.
if [[ -n $last ]]; then
  notes_args+=(-f previous_tag_name="$last")
fi

gh api "repos/{owner}/{repo}/releases/generate-notes" "${notes_args[@]}" --jq .body >"$notes"

echo "release: review the notes; an editor error or empty notes cancels" >&2

# git var, not $EDITOR: it answers with core.editor, $GIT_EDITOR, $VISUAL and
# $EDITOR in git's own order, so the editor here is the one every other part
# of the workflow already opens.
editor=$(git var GIT_EDITOR)
eval "$editor \"\$notes\"" || die "the editor exited with an error, nothing released"

grep -q '[^[:space:]]' "$notes" || die "the notes are empty, so nothing was released"

git tag -s "$version" -m "$version"

# Signing failing silently is the thing this script exists to prevent, so the
# tag is read back before anything leaves the machine. Verifying needs the
# signing key listed in gpg.ssh.allowedsignersfile.
if ! git tag -v "$version" >/dev/null 2>&1; then
  git tag -d "$version" >/dev/null
  die "the tag did not verify, so nothing was pushed"
fi

git push origin "$version"

# --verify-tag refuses to invent a tag if the push above did not land, and
# --fail-on-no-commits is the same guard as the rev-list above, on GitHub's
# side of the line this time.
gh release create "$version" \
  --title "$version" \
  --notes-file "$notes" \
  --verify-tag \
  --fail-on-no-commits
