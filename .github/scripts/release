#!/bin/sh
#
# Cuts a release: a signed tag on the default branch, and a GitHub release
# whose notes are the pull requests merged since the last one, opened in my
# editor first so I can fix them before anyone sees them.
#
#   .github/scripts/release patch|minor|major|vX.Y.Z
#
# The argument is usually the bump, and the next version is computed from the
# last release. A version spelled out has to be one of the three the bumps
# offer, so a wrong one is refused before any of the work. Before the tag, the
# version has to be typed back in full.
#
# The tag goes on the tip of origin's default branch as fetched, so the branch
# checked out here and its state do not matter. Tags never move, so a release
# that went out wrong is fixed by the next patch version; only the notes can
# still be edited, on the release page.
#
# Needs an authenticated gh at 2.68.0 or newer and a git configured for signing
# tags.

set -eu

prog=${0##*/}
REMOTE=origin
readonly REMOTE

die() {
  printf '%s: %s\n' "$prog" "$*" >&2
  exit 1
}

usage() {
  cat >&2 <<EOF
usage: $prog {patch|minor|major|vX.Y.Z}

  patch    v0.3.5 -> v0.3.6
  minor    v0.3.5 -> v0.4.0
  major    v0.3.5 -> v1.0.0
  vX.Y.Z   whichever of the three above it spells out
EOF
  exit 2
}

# fits16 N -> N is a plain decimal (no sign, no leading zero) that fits a
# signed int16, as every version component here must.
fits16() {
  case $1 in
  '' | *[!0-9]* | 0[0-9]*) return 1 ;;
  esac
  [ ${#1} -le 5 ] && [ "$1" -le 32767 ]
}

kind=''
want=''
case ${1:-} in
patch | minor | major) kind=$1 ;;
v*) want=$1 ;;
*) usage ;;
esac
[ $# -eq 1 ] || usage

# Only the shape is checked here; whether it is a version this release may
# take waits for the tags.
if [ -n "$want" ]; then
  case $want in
  *.*.*) ;;
  *) die "$want is not a version: write it as vX.Y.Z" ;;
  esac

  rest=${want#v}
  wma=${rest%%.*}
  rest=${rest#*.}
  wmi=${rest%%.*}
  wpa=${rest#*.}
  for c in "$wma" "$wmi" "$wpa"; do
    fits16 "$c" ||
      die "$want is not a version: X, Y and Z must be plain numbers, at most 32767"
  done
fi

cd "$(dirname "$0")/../.." || die 'could not reach the repository root'
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die 'not inside a git repository'

# A run that could never confirm on /dev/tty stops here, before anything is
# fetched. All three fds must be terminals, since every prompt goes to stderr.
#
# NOTE: /dev/tty is tried in a subshell. A failed redirect on exec, a special
# builtin, kills a POSIX shell on the spot and the message is lost.
if ! { [ -t 0 ] && [ -t 1 ] && [ -t 2 ]; }; then
  die 'there is no terminal, so the notes cannot be reviewed'
fi
(exec </dev/tty) 2>/dev/null || die '/dev/tty will not open, so the notes cannot be reviewed'

# gh has to be there, logged in and at 2.68.0 or newer for `gh release create
# --fail-on-no-commits`. It is asked now, because by the release the tag is
# already pushed.
ghver=$(gh --version 2>/dev/null) || die 'gh is not installed'
ghver=${ghver#gh version }
ghver=${ghver%% *}
[ "$(printf '2.68.0\n%s\n' "$ghver" | sort -t. -k1,1n -k2,2n -k3,3n | head -n1)" = 2.68.0 ] ||
  die "gh $ghver is too old: --fail-on-no-commits needs gh 2.68.0 or newer"
gh auth status >/dev/null 2>&1 || die 'gh is not authenticated; run: gh auth login'

# The editor git would open, from core.editor, $VISUAL or $EDITOR.
editor=$(git var GIT_EDITOR) || die 'could not resolve an editor'

# NOTE: the repository is resolved from $REMOTE's url and not from gh's own
# default, which can be another repository (a fork, say). The release would
# then target one repository while the tag lands on another.
url=$(git remote get-url "$REMOTE" 2>/dev/null) || die "there is no $REMOTE remote"
info=$(gh repo view "$url" --json nameWithOwner,defaultBranchRef \
  --jq '.nameWithOwner + " " + .defaultBranchRef.name') ||
  die "could not resolve the GitHub repository behind $REMOTE"
repo=${info%% *}
branch=${info##* }
[ -n "$branch" ] || die "could not resolve the default branch of $repo"

git fetch --quiet --tags --force "$REMOTE" "refs/heads/$branch" ||
  die "could not fetch $branch and tags from $REMOTE"
sha=$(git rev-parse --verify --quiet "FETCH_HEAD^{commit}") ||
  die "could not resolve the head of $branch"
short=$(git rev-parse --short "$sha")

# The release this one follows: the highest plain vX.Y.Z the head can reach,
# or nothing. It is both the number that gets bumped and where the notes
# start, read once so the two cannot disagree.
previous=$(git tag --list --merged "$sha" --sort=v:refname 'v*' |
  grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' |
  tail -n1)

# bump TAG KIND -> the next tag. The components are checked before the
# arithmetic, because $(( )) reads a leading zero as octal, and after it, so
# the result fits too.
bump() {
  _v=${1#v}
  _ma=${_v%%.*}
  _v=${_v#*.}
  _mi=${_v%%.*}
  _pa=${_v#*.}
  for _c in "$_ma" "$_mi" "$_pa"; do
    fits16 "$_c" || die "cannot bump $1: $_c is not a plain number within int16"
  done
  case $2 in
  patch) _pa=$((_pa + 1)) ;;
  minor)
    _mi=$((_mi + 1))
    _pa=0
    ;;
  major)
    _ma=$((_ma + 1))
    _mi=0
    _pa=0
    ;;
  esac
  for _c in "$_ma" "$_mi" "$_pa"; do
    fits16 "$_c" || die "cannot bump $1: the result does not fit int16"
  done
  printf 'v%s.%s.%s\n' "$_ma" "$_mi" "$_pa"
}

base=${previous:-v0.0.0}

if [ -n "$want" ]; then
  # all three, since the refusal names them
  patchv=$(bump "$base" patch)
  minorv=$(bump "$base" minor)
  majorv=$(bump "$base" major)

  case $want in
  "$patchv" | "$minorv" | "$majorv") next=$want ;;
  *)
    die "$base does not take $want; it takes" \
      "$patchv (patch), $minorv (minor), $majorv (major)"
    ;;
  esac
else
  # NOTE: only the one asked for. Bumping all three would let a component at
  # the int16 ceiling refuse a release that never touches it: v1.32767.0
  # takes a patch, and only the minor has nowhere to go.
  next=$(bump "$base" "$kind")
fi

# The tag list above is local, so a release cut elsewhere a moment ago only
# shows up when the remote is asked.
if git rev-parse -q --verify "refs/tags/$next" >/dev/null; then
  die "$next already exists locally"
fi
# NOTE: ls-remote says "absent" only with exit code 2. Anything else means the
# check itself failed, and a failed check must not pass for absence.
if git ls-remote --exit-code --tags "$REMOTE" "refs/tags/$next" >/dev/null 2>&1; then
  die "$next already exists on $REMOTE"
elif [ $? -ne 2 ]; then
  die "could not check $REMOTE for $next"
fi

if [ -n "$previous" ] && [ "$(git rev-list --count "$previous..$sha")" -eq 0 ]; then
  die "nothing has landed on $branch since $previous"
fi

printf '%s: %s is at %s (%s)\n' "$prog" "$branch" "$short" \
  "$(git log -1 --format=%s "$sha")" >&2
printf '%s: preparing %s (notes since %s)\n' "$prog" "$next" "${previous:-the first commit}" >&2

# NOTE: the notes start from $previous, named here. Left to choose on its own,
# the API can reach past the last tag and list the whole history again.
set -- -f "tag_name=$next" -f "target_commitish=$sha"
if [ -n "$previous" ]; then
  set -- "$@" -f "previous_tag_name=$previous"
fi

# The notes come first, because generating them creates nothing, so the
# review below happens while an abort still costs nothing.
#
# NOTE: a whole directory for one file, because the name has to end in .md for
# the editor to open it as markdown, and a suffix after mktemp's template is
# not portable.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
notes=$work/notes.md

# NOTE: written to a file rather than piped. sh has no pipefail, so a failing
# gh would be hidden behind awk succeeding on empty input.
gh api -X POST "repos/$repo/releases/generate-notes" "$@" --jq .body >"$work/raw" ||
  die 'could not generate release notes'

# Tidies the notes for reading in the editor: one blank line around a heading,
# never two in a row, none at the end. It also drops the html comment the API
# puts on the first line when .github/release.yml exists, which the release
# page hides but the tag would carry as text.
awk '
  NR == 1 && /^<!--.*-->$/ { next }

  $0 == "" { pending = 1; next }
  {
    cur = ($0 ~ /^#+ /)
    if (printed && (pending || heading || cur)) print ""
    print
    printed = 1
    pending = 0
    heading = cur
  }
' "$work/raw" >"$notes"

[ -s "$notes" ] || printf '%s\n' "$next" >"$notes"

# Reviewed in the editor, then confirmed by typing the tag back. Nothing
# exists until both have happened.
printf '%s: review the notes; an editor error or empty notes cancels\n' "$prog" >&2
eval "$editor" '"$notes"' || die 'the editor aborted, so nothing was tagged'
grep -q '[^[:space:]]' "$notes" || die 'the notes are empty, so nothing was tagged'

# NOTE: the version is read from /dev/tty and not from stdin, so no pipe or
# yes(1) can answer it. This is the guard on the review, since git lets the
# editor be anything, `true` included. It asks for the version and not a y,
# so habit cannot answer it either.
#
# The prompt names the previous release and the commit again, since the lines
# that said so have scrolled away behind the notes.
if [ -n "$previous" ]; then
  prevnote="previous was $previous"
else
  prevnote='no previous release'
fi
printf '%s: type %s to confirm (%s, at %s): ' "$prog" "$next" "$prevnote" "$short" >&2
reply=''
IFS= read -r reply </dev/tty || true
[ "$reply" = "$next" ] || die "that was not $next, so nothing was tagged"

# The notes go in the tag as well as the release, so `git show $next` says what
# shipped with nothing to fetch.
#
# NOTE: never `git tag -a`. On the command line -a overrides
# tag.forceSignAnnotated and writes an unsigned tag without a word, and GitHub
# does not catch it either, since its rulesets check the commit a tag points
# at and not the tag itself. `-s` and the verify below are the whole guard.
#
# NOTE: --cleanup=whitespace keeps the notes whole. Without it git tag drops
# every line that starts with '#', which is every markdown heading, even with
# -F.
git tag -s -F "$notes" --cleanup=whitespace "$next" "$sha"

# The tag is read back before anything leaves the machine. Verifying needs the
# signing key listed in gpg.ssh.allowedsignersfile.
if ! git tag -v "$next" >/dev/null 2>&1; then
  git tag -d "$next" >/dev/null
  die 'the tag did not verify, so nothing was pushed'
fi

git push --quiet "$REMOTE" "refs/tags/$next" ||
  die "$next was tagged locally but the push failed; retry with: git push $REMOTE $next"

# The release carries the same notes, for dependabot to pull into the bump
# pull requests it opens downstream. --verify-tag refuses to make a tag if the
# push above did not land, and --fail-on-no-commits repeats the rev-list check
# on GitHub's side.
gh release create "$next" \
  --repo "$repo" \
  --title "$next" \
  --notes-file "$notes" \
  --verify-tag \
  --fail-on-no-commits ||
  die "$next is tagged and pushed but the release was not created; retry with:" \
    "gh release create $next --repo $repo --title $next --notes-from-tag --verify-tag"

# The local branch is fast-forwarded, best effort, since the release is out
# either way. The one checked out takes a merge, because git refuses to fetch
# into it.
if [ "$(git branch --show-current)" = "$branch" ]; then
  git merge --quiet --ff-only "$sha" 2>/dev/null || true
else
  git fetch --quiet "$REMOTE" "refs/heads/$branch:refs/heads/$branch" 2>/dev/null || true
fi

printf '%s: released %s at %s\n' "$prog" "$next" "$short"
