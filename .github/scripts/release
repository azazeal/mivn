#!/usr/bin/env bash
#
# Cuts a release: a signed tag on main, and a GitHub release whose notes are
# the pull requests merged since the last one, opened in my editor first so I
# can fix them before anyone sees them.
#
#   release patch|minor|major
#
# The argument is the bump, not the version: the next version is computed
# from the last tag once main is synced, minor for a monthly batch, patch for
# a fix between batches. Versions are semver with a leading v, since a tag
# that is not semver is invisible to anything that compares versions. The
# confirmation before the tag asks for the computed version, typed back in
# full, so which version is being cut is never left unread.
#
# `git tag -a` is never used here and must never be: -a on the command line
# overrides tag.forceSignAnnotated, so it writes an unsigned annotated tag and
# says nothing about it. GitHub does not catch that either, since a tag
# ruleset's "require signed commits" checks the commit the tag points at, not
# the tag object. `-s` plus the verify below is the whole guard.
#
# Releases are immutable and the "tags never move" ruleset blocks force-pushing
# any tag, so a release that went out wrong is fixed by cutting the next patch
# version, never by moving this one. The notes are the one part still editable
# afterwards, on the release page.

set -euo pipefail
cd "$(dirname "$0")/../.."

die() {
  echo "release: $1" >&2
  exit 1
}

bump="${1:?usage: release patch|minor|major}"

case $bump in
  patch | minor | major) ;;
  *) die "$bump is not patch, minor or major" ;;
esac

# Reviewing the notes is the whole point of the editor below, and skipping
# it is silent: an editor with no terminal returns at once, `true` as the
# editor returns at once with one, and either way the notes come back
# readable, so the release goes out with whatever the API wrote. What tells
# a reviewed run from a skipped one is not the editor, which git allows to
# be anything including `true`, but the terminal: the run has to be
# interactive, and right before the tag the version is typed back on
# /dev/tty, which no pipe, heredoc or no-op editor can answer for.
[[ -t 0 && -t 1 ]] || die "there is no terminal, so the notes cannot be reviewed"

# The terminal the confirmation reads from, opened this early so a run that
# could never confirm fails now, before anything is fetched or generated. The
# braces scope the 2>/dev/null (bash's own noise on failure) to this line;
# hanging it on the exec directly would make it permanent on success and eat
# every message after it. exec's own fd survives the group.
{ exec 3</dev/tty; } 2>/dev/null || die "/dev/tty will not open, so the notes cannot be reviewed"

# The tag names a commit everyone else can fetch, so this cuts from main at
# exactly what the remote carries. Getting there is this script's job and not
# mine to remember: whatever branch I am on, it switches and fast-forwards.
# Only a dirty tree stops it, because that is the one state where switching
# would take my changes along with it.
[[ -z $(git status --porcelain) ]] || die "the working tree is dirty"

# --tags because the next version is read off the last one: a release cut
# elsewhere that never made it here would otherwise recompute an existing
# version. The duplicate checks below would still catch that, but loudly and
# late; fetching the tags makes the computed version right the first time.
git fetch --quiet --tags origin main

if [[ $(git branch --show-current) != "main" ]]; then
  echo "release: switching to main" >&2
  git switch --quiet main
fi

git merge --quiet --ff-only origin/main || die "main has commits the remote does not"

last=$(git describe --tags --abbrev=0 2>/dev/null || true)
if [[ -n $last && $(git rev-list --count "$last..HEAD") -eq 0 ]]; then
  die "nothing has landed since $last"
fi

major=0 minor=0 patch=0
if [[ -n $last ]]; then
  [[ $last =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "the last tag, $last, is not vMAJOR.MINOR.PATCH"
  IFS=. read -r major minor patch <<<"${last#v}"
fi

case $bump in
  major) version="v$((major + 1)).0.0" ;;
  minor) version="v$major.$((minor + 1)).0" ;;
  patch) version="v$major.$minor.$((patch + 1))" ;;
esac

echo "release: ${last:-nothing} -> $version" >&2

# Both can still trip after the fetch above: describe walks HEAD's ancestry,
# so a higher tag off on a side branch is invisible to it.
if git rev-parse -q --verify "refs/tags/$version" >/dev/null; then
  die "$version already exists locally"
fi

if git ls-remote --exit-code --tags origin "refs/tags/$version" >/dev/null 2>&1; then
  die "$version already exists on the remote"
fi

# The notes come first, because generating them creates nothing: the API reads
# the pull requests merged since the last release and hands them back. So the
# review below happens while an abort still costs nothing, with no tag written
# and nothing pushed.
#
# A whole directory for one file, because the name has to end in .md: this is
# the one file I hand-edit every release, and without the extension the editor
# reads no filetype off it, so the notes open as plain text with no
# highlighting, no `gq` and no spell check. A suffix after mktemp's template is
# not portable, a temporary directory is.
notes=$(mktemp -d)/notes.md
trap 'rm -rf "$(dirname "$notes")"' EXIT

notes_args=(-f tag_name="$version" -f target_commitish="$(git rev-parse HEAD)")

# Which release this one follows, said outright. Left to itself the API works
# it out from the target commit and has been seen to reach past the last tag,
# listing the whole history again.
if [[ -n $last ]]; then
  notes_args+=(-f previous_tag_name="$last")
fi

# Straight from the API the notes have no blank line after the heading and two
# before the changelog link. Both render the same, but this file is opened in
# an editor and read as markdown before it is rendered anywhere, so the source
# is tidied on the way in: one blank line after a heading, never two in a row,
# and none left at the end.
tidy() {
  awk '
    $0 == "" { pending = 1; next }
    {
      if (printed && (pending || heading)) print ""
      print
      printed = 1
      pending = 0
      heading = ($0 ~ /^#+ /)
    }
  '
}

gh api "repos/{owner}/{repo}/releases/generate-notes" "${notes_args[@]}" --jq .body | tidy >"$notes"

echo "release: review the notes; an editor error or empty notes cancels" >&2

# git var, not $EDITOR: it answers with core.editor, $GIT_EDITOR, $VISUAL and
# $EDITOR in git's own order, so the editor here is the one every other part
# of the workflow already opens.
editor=$(git var GIT_EDITOR)
eval "$editor \"\$notes\"" || die "the editor exited with an error, nothing released"

grep -q '[^[:space:]]' "$notes" || die "the notes are empty, so nothing was released"

# The backstop: after the notes were on screen, the version is typed back on
# the terminal itself. fd 3 is /dev/tty from the top of the script, so no
# pipe, heredoc or yes(1) can answer this; it asks for the version rather
# than a y so muscle memory cannot either.
read -r -u 3 -p "release: type $version to confirm: " typed || typed=""

[[ $typed == "$version" ]] || die "that was not $version, so nothing was released"

git tag -s "$version" -m "$version"

# Signing failing silently is the thing this script exists to prevent, so the
# tag is read back before anything leaves the machine. Verifying needs the
# signing key listed in gpg.ssh.allowedsignersfile.
if ! git tag -v "$version" >/dev/null 2>&1; then
  git tag -d "$version" >/dev/null
  die "the tag did not verify, so nothing was pushed"
fi

git push origin "$version"

# --verify-tag refuses to invent a tag if the push above did not land, and
# --fail-on-no-commits is the same guard as the rev-list above, on GitHub's
# side of the line this time.
gh release create "$version" \
  --title "$version" \
  --notes-file "$notes" \
  --verify-tag \
  --fail-on-no-commits
