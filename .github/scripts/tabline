#!/usr/bin/env bash
#
# Draws the tab bar on a real editor and says where it put things.
#
#   tabline            every case
#   tabline <pattern>  the cases whose name matches the Lua pattern
#
# Wants nvim on $PATH, and a pty, which `script` (util-linux) provides.
# Prints one row per case, ok or FAIL with what was expected and what
# happened, and exits non-zero on any FAIL.
#
# Each case checks the columns above the file tree: that the strip starts with
# the project's name, that the buffers start one column past the tree however
# many there are, and that a click up there lands where it looks like it
# lands. The bar only goes wrong past a number of buffers, when it is wider
# than the screen and slides over the tree. The cases are in
# .github/checks/tabline.lua.

name=tabline
# shellcheck source=SCRIPTDIR/../checks/harness.sh
. "$(dirname "$0")/../checks/harness.sh"

start
load
list=$(matching)
stop

for i in $list; do
  # One editor per case, since none of them undoes what it opened.
  sleep 0.3
  start
  load

  nv "luaeval('M.setup(_A)', $i)" > /dev/null
  sleep 0.5

  # NOTE: the clicks go in over the socket, one call each, because injected
  # mouse input is only read once the editor is back in its own loop. Sent
  # from inside a callback, a click is dropped and the case passes with
  # nothing pressed.
  for n in $(seq 1 "$(nv "luaeval('M.clicks(_A)', $i)")"); do
    nv "luaeval('M.click(_A[1], _A[2])', [$i, $n])" > /dev/null
    sleep 0.3
    nv "luaeval('M.landed(_A)', $n)" > /dev/null
  done

  report "$(nv "luaeval('M.verdict(_A)', $i)")"
  stop
done

exit $status
