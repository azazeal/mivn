#!/usr/bin/env bash
#
# Draws the tab bar on a real editor and says where it put things.
#
#   tabline            every case
#   tabline <pattern>  the cases whose name contains it
#
# Wants nvim on $PATH, and a pty, which `script` (util-linux) provides.
# Prints one row per case, ok or FAIL with what was expected and what
# happened, and exits non-zero on any FAIL.
#
# What each case checks is the columns above the file tree: that the strip
# starts with the project's name, that the buffers start one column past the
# tree whatever else is going on, and that a click up there lands where it
# looks like it lands.
#
# Why this exists. mini.tabline fits its string to the whole screen rather
# than to what is left of it, so with enough buffers open the padded line was
# wider than the screen, and a tabline with no `%<` is cut at its start: the
# padding went first and the tabs slid over the tree. They were live up there
# too, so clicking what looked like the tree switched buffers. Nothing asked
# the tab bar what it drew until this, and it only goes wrong past a buffer
# count, which is why looking at it once said it was fine.
#
# WARN: the clicks go in over the socket, one call each, because injected
# mouse input is only read once the editor is back in its own loop. Sent from
# inside a callback, with `vim.wait` or `nvim_feedkeys` between, every click
# in here was swallowed and the case passed while nothing had been pressed.
#
# The cases are in .github/checks/tabline.lua; .github/checks/harness.sh has
# the rest.

name=tabline
# shellcheck source=SCRIPTDIR/../checks/harness.sh
. "$(dirname "$0")/../checks/harness.sh"

start
load
list=$(matching)
stop

for i in $list; do
  # One editor per case. None of them undoes what it opened, so a shared one
  # would have the cases deciding each other's starting state.
  sleep 0.3
  start
  load

  nv "luaeval('M.setup(_A)', $i)" > /dev/null
  sleep 0.5

  for n in $(seq 1 "$(nv "luaeval('M.clicks(_A)', $i)")"); do
    nv "luaeval('M.click(_A[1], _A[2])', [$i, $n])" > /dev/null
    sleep 0.3
    nv "luaeval('M.landed(_A)', $n)" > /dev/null
  done

  report "$(nv "luaeval('M.verdict(_A)', $i)")"
  stop
done

exit $status
