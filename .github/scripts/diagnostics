#!/usr/bin/env bash
#
# Draws diagnostics under the line on a real editor and reads back what came
# out.
#
#   diagnostics            every case
#   diagnostics <pattern>  the cases whose name matches the Lua pattern
#
# Wants nvim on $PATH, and a pty, which `script` (util-linux) provides. Prints
# one row per case, ok or FAIL with what came out wrong, and exits non-zero on
# any FAIL.
#
# Each case checks the block lua/mivn/lsp.lua wraps: a short message stays one
# row with its elbow, a long one breaks on its spaces and rejoins to the text
# that went in, nothing drawn reaches the window's last column, and a message
# capped at a third of the window ends in an ellipsis. The wrap has to count
# cells and not bytes, and getting that wrong only shows on a line that is not
# ASCII.
#
# The diagnostics go in through vim.diagnostic.set, so no language server is
# needed. The cases are in .github/checks/diagnostics.lua.

name=diagnostics
# shellcheck source=SCRIPTDIR/../checks/harness.sh
. "$(dirname "$0")/../checks/harness.sh"

fixture=$work/fixture.txt
: > "$fixture"

# A case wants a 140-column window, and the default pty is not that wide.
cols=170
rows=45
start "$fixture"
load

for i in $(matching); do
  nv "luaeval('M.setup(_A)', $i)" > /dev/null
  sleep 0.4

  # The resize is its own call, once the diagnostics are drawn: the case is
  # about a wrap made for the width the window had before.
  if [ "$(nv "luaeval('M.resizes(_A)', $i)")" = 1 ]; then
    nv "luaeval('M.resize(_A)', $i)" > /dev/null
    sleep 0.4
  fi

  report "$(nv "luaeval('M.verdict(_A)', $i)")"
done

stop
exit $status
