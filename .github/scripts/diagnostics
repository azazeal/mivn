#!/usr/bin/env bash
#
# Draws diagnostics under the line on a real editor and reads back what came
# out.
#
#   diagnostics            every case
#   diagnostics <pattern>  the cases whose name matches the Lua pattern
#
# Wants nvim on $PATH, and a pty, which `script` (util-linux) provides. Prints
# one row per case, ok or FAIL with what came out wrong, and exits non-zero on
# any FAIL.
#
# What each case checks is the block lua/mivn/lsp.lua wraps: that a short
# message is still one row with its elbow, that a long one is broken on its
# spaces and rejoins to the text that went in, that nothing drawn reaches the
# last column of the window, and that a message capped at a third of the
# window ends with the ellipsis that points at `Ctrl+W d`.
#
# Why this exists. Neovim's handler draws the block with
# `virt_lines_overflow = 'scroll'`, which only truncates, so mivn wraps the
# message itself before handing it over. That arithmetic is in cells and not
# in bytes, and the difference only shows on a line that is not ASCII: a Greek
# message wraps about a third too early and a Japanese one runs off the edge,
# and both of them look fine in English.
#
# WARN: whether a row fits is read off the screen with screenstring() and not
# off the extmark. Asking the extmark how wide it is would be asking the same
# arithmetic that put the breaks in, and the two agreeing about a window's
# width is exactly the bug worth catching.
#
# The diagnostics are injected with vim.diagnostic.set, so no language server
# is needed and CI checks the same thing this machine does.
#
# The cases are in .github/checks/diagnostics.lua; .github/checks/harness.sh
# has the rest.

name=diagnostics
# shellcheck source=SCRIPTDIR/../checks/harness.sh
. "$(dirname "$0")/../checks/harness.sh"

fixture=$work/fixture.txt
: > "$fixture"

# A case wants a 140-column window, and the default pty is not that wide.
cols=170
rows=45
start "$fixture"
load

for i in $(matching); do
  nv "luaeval('M.setup(_A)', $i)" > /dev/null
  sleep 0.4

  # The resize goes in as its own call, after the diagnostics are already
  # published, because that is the state the wrap cannot see coming: the
  # widths it used are the ones the window had a moment ago.
  if [ "$(nv "luaeval('M.resizes(_A)', $i)")" = 1 ]; then
    nv "luaeval('M.resize(_A)', $i)" > /dev/null
    sleep 0.4
  fi

  report "$(nv "luaeval('M.verdict(_A)', $i)")"
done

stop
exit $status
