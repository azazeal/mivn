#!/usr/bin/env bash
#
# Restarts a real editor and says what came back.
#
#   restart            every case
#   restart <pattern>  the cases whose name matches the Lua pattern
#
# Wants nvim on $PATH and a pty, which `script` (util-linux) provides. Prints
# one row per case, ok or FAIL with what was expected and what happened, and
# exits non-zero on any FAIL.
#
# Each of :restart, ZR and 1ZR is tried with nothing to save and with unsaved
# work. A case reads the pid, whether the terminal and the second file came
# back, and whether a refusal came as an error or as a traceback, so it
# catches a restart that drops the session or the panels. The cases are in
# .github/checks/restart.lua.

name=restart
# shellcheck source=SCRIPTDIR/../checks/harness.sh
. "$(dirname "$0")/../checks/harness.sh"

anchor=$work/anchor.txt
witness=$work/witness.txt
printf 'anchor\n' > "$anchor"
printf 'witness\n' > "$witness"

# A restarted editor inherits this environment, so the paths survive it.
editor_env="MIVN_ANCHOR='$anchor' MIVN_WITNESS='$witness'"
start "$anchor"

# Waits until the editor answers again, with a pid other than $1, or with any
# pid when $1 is `any`, and fails when it never does. A restart drops the
# connection until the new server is up and has sourced the session; it
# listens on the same address, so the same socket reaches it.
settle() {
  sleep 1

  for _ in $(seq 1 120); do
    now=$(timeout 5 nvim --server "$sock" --remote-expr 'getpid()' 2>/dev/null) || now=""

    if [ -n "$now" ] && { [ "$1" = any ] || [ "$now" != "$1" ]; }; then
      return 0
    fi

    sleep 0.25
  done

  return 1
}

load

for i in $(matching); do
  was=$(nv "luaeval('M.setup(_A)', $i)")
  sleep 0.3

  # NOTE: the keys go in through nvim_input and never nvim_exec2. mivn
  # rewrites a typed :restart in a CmdlineLeavePre autocmd, which only fires
  # on a line that was typed, so nvim_exec2 would walk past all of it.
  for j in $(seq 1 "$(nv "luaeval('M.keys(_A)', $i)")"); do
    nv "luaeval('M.press(_A[1], _A[2])', [$i, $j])" > /dev/null
    sleep 0.12
  done

  # An editor that never answers again is a failure, not a reason to hang.
  if ! settle any; then
    report "  FAIL  case $i: the editor stopped answering after the keys"
    continue
  fi

  # A restart is a new process, and takes the whole Lua state with it.
  load

  report "$(nv "luaeval('M.verdict(_A[1], _A[2])', [$i, $was])")"
done

stop
exit $status
